---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout title="Signing you in…" variant="hero">
  <main class="flex min-h-screen items-center justify-center px-4">
    <div class="glass-strong p-8 text-center max-w-sm w-full animate-fade-in">
      <div class="mx-auto mb-4 h-12 w-12 rounded-2xl bg-brand-grad shadow-glow flex items-center justify-center animate-pulse-glow">
        <svg class="h-6 w-6 text-white animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
        </svg>
      </div>
      <h1 class="font-display text-xl font-semibold">Signing you in…</h1>
      <p class="mt-2 text-sm text-ink-muted" id="status-text">Securing your session.</p>
      <p id="error-text" class="hidden mt-3 text-sm text-accent-rose"></p>
    </div>
  </main>

  <script>
    import { handleRedirectCallback } from '@lib/auth/auth0Client';

    const status = document.getElementById('status-text');
    const err = document.getElementById('error-text');

    (async () => {
      try {
        const payload = await handleRedirectCallback();
        if (!payload) {
          throw new Error('callback returned no session');
        }
        status.textContent = 'Done — taking you to your dashboard.';
        window.location.replace('/products');
      } catch (e) {
        console.error(e);
        const msg = String(e?.message || '');
        if (msg.includes('provisioning_fetch_failed:403')) {
          window.location.replace('/login?reason=not_activated');
          return;
        }
        err.textContent = 'We could not complete sign-in. Please try again.';
        err.classList.remove('hidden');
        setTimeout(() => window.location.replace('/login'), 1800);
      }
    })();
  </script>
</BaseLayout>

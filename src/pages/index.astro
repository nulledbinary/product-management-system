---
// Static landing page: bounces to /dashboard. The AppShell guard there will
// kick unauthenticated visitors over to /login.
const target = '/dashboard';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <title>HopePMS</title>
  </head>
  <body>
    <script is:inline>window.location.replace('/dashboard');</script>
    <noscript>
      <a href={target}>Continue to HopePMS</a>
    </noscript>
  </body>
</html>

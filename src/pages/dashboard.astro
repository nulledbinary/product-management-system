---
import AppShell from '@layouts/AppShell.astro';
---
<AppShell title="Dashboard" subtitle="Overview of your catalogue and recent activity.">
  <section class="space-y-6">
    <!-- ─── Mini-statistics row (vision-ui MiniStatistics) ─────────────── -->
    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4 reveal">
      <div class="stat-card">
        <p class="stat-label">Active products</p>
        <p class="stat-figure" data-stat="active">—</p>
        <p class="stat-sub">Visible across the catalogue.</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Distinct units</p>
        <p class="stat-figure" data-stat="units">—</p>
        <p class="stat-sub">pc · ea · mtr · pkg · ltr</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Average price</p>
        <p class="stat-figure" data-stat="avg">—</p>
        <p class="stat-sub">Mean of current prices.</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Your role</p>
        <p class="stat-figure-sm" data-usertype>—</p>
        <p class="stat-sub" data-username>—</p>
      </div>
    </div>

    <!-- ─── Welcome + breakdown (vision-ui Welcome / Satisfaction) ─────── -->
    <div class="grid gap-5 lg:grid-cols-3">
      <div class="card relative overflow-hidden bg-mesh-hero lg:col-span-2 min-h-[220px] flex flex-col">
        <p class="text-2xs font-semibold uppercase tracking-wider text-ink-dim">Welcome back,</p>
        <h2 class="mt-1 font-display text-3xl font-semibold tracking-tight" data-username>—</h2>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-ink-muted">
          Glad to see you again. Here is where your catalogue and recent
          administrative activity come together at a glance.
        </p>
        <div class="mt-auto pt-6">
          <a href="/products" class="btn-primary h-9 px-5 text-sm">
            Go to products
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>

      <div class="card">
        <div class="flex items-start justify-between">
          <div>
            <p class="font-display text-base font-semibold tracking-tight">Catalogue breakdown</p>
            <p class="text-xs text-ink-dim">Active products by unit.</p>
          </div>
        </div>
        <ul id="unit-bars" class="mt-5 space-y-3">
          {Array.from({ length: 5 }).map(() => (
            <li><div class="skeleton h-8 w-full rounded-lg"></div></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- ─── Recent activity + quick links (vision-ui Projects / Orders) ── -->
    <div class="grid gap-5 lg:grid-cols-3">
      <div class="card !p-0 overflow-hidden lg:col-span-2">
        <div class="flex items-center justify-between px-6 pt-6 pb-4">
          <div>
            <p class="font-display text-base font-semibold tracking-tight" data-activity-title>Recent activity</p>
            <p class="text-xs text-ink-dim" data-activity-sub>Latest events across the system.</p>
          </div>
        </div>
        <ul id="activity-list" class="divide-y divide-line/60">
          {Array.from({ length: 6 }).map(() => (
            <li class="flex items-center gap-4 px-6 py-3.5">
              <div class="skeleton h-2.5 w-2.5 rounded-full"></div>
              <div class="flex-1"><div class="skeleton h-4 w-2/3"></div></div>
              <div class="skeleton h-3 w-24"></div>
            </li>
          ))}
        </ul>
        <div id="activity-empty" class="hidden p-12 text-center">
          <p class="font-display text-base font-medium">Nothing yet</p>
          <p class="text-sm text-ink-dim">Activity will appear here as the catalogue is used.</p>
        </div>
      </div>

      <div class="card">
        <p class="font-display text-base font-semibold tracking-tight">Quick links</p>
        <p class="text-xs text-ink-dim">Jump straight to what you can manage.</p>
        <nav class="mt-4 flex flex-col gap-1.5">
          <a href="/products" class="nav-item">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 12l9 4 9-4"/><path d="M3 17l9 4 9-4"/></svg>
            Product List
          </a>
          <a href="/products/deleted" data-right="deleted" class="nav-item hidden">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
            Deleted Items
          </a>
          <a href="/reports/product-listing" data-right="REP_001" class="nav-item hidden">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17v-6"/><path d="M12 17V7"/><path d="M15 17v-4"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
            Product Listing
          </a>
          <a href="/reports/top-selling" data-right="REP_002" class="nav-item hidden">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>
            Top Selling
          </a>
          <a href="/admin/users" data-right="ADM_USER" class="nav-item hidden">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
            Manage Users
          </a>
          <a href="/admin/logs" data-right="ADM_USER" class="nav-item hidden">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>
            Activity Log
          </a>
          <a href="/admin/superadmins" data-owner class="nav-item hidden">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9.5 12l2 2 3.5-4"/></svg>
            SUPERADMIN Control
          </a>
        </nav>
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck
    import { listProducts } from '@lib/api/products';
    import { getAdminLogs } from '@lib/api/users';
    import { loadSession } from '@lib/auth/volatileSession';
    import { isAdmin } from '@lib/auth/rights';
    import { startLiveRefresh } from '@lib/utils/liveRefresh';
    import { escapeHtml } from '@lib/security/sanitize';
    import { countUp } from '@lib/utils/animateNumber';

    const unitBars = document.getElementById('unit-bars');
    const activityList = document.getElementById('activity-list');
    const activityEmpty = document.getElementById('activity-empty');
    const activityTitle = document.querySelector('[data-activity-title]');
    const activitySub = document.querySelector('[data-activity-sub]');

    let session = null;

    const ACTION_LABEL = {
      USER_CREATE: 'User created', USER_DELETE: 'User deleted',
      USER_PROMOTE: 'User promoted', USER_DEMOTE: 'User demoted',
      USER_ACTIVATE: 'User activated', USER_DEACTIVATE: 'User deactivated',
      PRODUCT_CREATE: 'Product added', PRODUCT_UPDATE: 'Product updated',
      PRODUCT_DELETE: 'Product deleted', PRODUCT_RECOVER: 'Product recovered',
    };
    const UNIT_ORDER = ['pc', 'ea', 'mtr', 'pkg', 'ltr'];

    function fmtPrice(n) {
      if (n == null || Number.isNaN(Number(n))) return '—';
      return new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' }).format(Number(n));
    }
    function fmtWhen(s) {
      const d = new Date(s);
      if (Number.isNaN(d.getTime())) return String(s ?? '');
      return d.toLocaleString(undefined, {
        month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit',
      });
    }

    function renderStats(active) {
      countUp(document.querySelector('[data-stat="active"]'), active.length);
      const units = new Set(active.map((p) => p.unit));
      countUp(document.querySelector('[data-stat="units"]'), units.size, { duration: 700 });
      const priced = active.map((p) => Number(p.currentPrice)).filter((n) => Number.isFinite(n));
      const avgEl = document.querySelector('[data-stat="avg"]');
      const avg = priced.length ? priced.reduce((a, b) => a + b, 0) / priced.length : 0;
      if (avgEl) avgEl.textContent = priced.length ? fmtPrice(avg) : '—';
    }

    function renderUnitBars(active) {
      const counts = {};
      for (const u of UNIT_ORDER) counts[u] = 0;
      for (const p of active) counts[p.unit] = (counts[p.unit] ?? 0) + 1;
      const max = Math.max(1, ...Object.values(counts));
      unitBars.innerHTML = UNIT_ORDER.map((u) => {
        const c = counts[u] ?? 0;
        const pct = Math.round((c / max) * 100);
        return `
          <li>
            <div class="flex items-center justify-between text-xs text-ink-muted">
              <span class="font-mono uppercase tracking-wider">${escapeHtml(u)}</span>
              <span class="tabular-nums">${c}</span>
            </div>
            <div class="mt-1.5 h-2 w-full overflow-hidden rounded-full bg-white/[0.06]">
              <div class="h-full origin-left rounded-full bg-ink/80 animate-bar-grow" style="width:${pct}%"></div>
            </div>
          </li>`;
      }).join('');
    }

    function renderActivityFromLogs(rows) {
      if (!rows.length) { activityList.innerHTML = ''; activityEmpty.classList.remove('hidden'); return; }
      activityEmpty.classList.add('hidden');
      activityList.innerHTML = rows.slice(0, 8).map((r) => `
        <li class="flex items-center gap-4 px-6 py-3.5">
          <span class="h-2 w-2 shrink-0 rounded-full bg-ink/60"></span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm">
              <span class="font-medium">${escapeHtml(ACTION_LABEL[r.action] || r.action || 'Event')}</span>
              <span class="text-ink-dim"> · ${escapeHtml(r.target ?? '')}</span>
            </p>
            <p class="truncate text-xs text-ink-dim">${escapeHtml(r.actorName ?? '—')}</p>
          </div>
          <span class="shrink-0 font-mono text-2xs text-ink-dim">${escapeHtml(fmtWhen(r.at))}</span>
        </li>`).join('');
    }

    function renderActivityFromProducts(active) {
      const rows = [...active]
        .sort((a, b) => String(b.stamp ?? '').localeCompare(String(a.stamp ?? '')))
        .slice(0, 8);
      if (!rows.length) { activityList.innerHTML = ''; activityEmpty.classList.remove('hidden'); return; }
      activityEmpty.classList.add('hidden');
      activityList.innerHTML = rows.map((p) => `
        <li class="flex items-center gap-4 px-6 py-3.5">
          <span class="h-2 w-2 shrink-0 rounded-full bg-ink/60"></span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm">
              <span class="font-mono text-xs">${escapeHtml(p.prodCode)}</span>
              <span class="text-ink-dim"> · ${escapeHtml(p.description)}</span>
            </p>
            <p class="truncate text-xs text-ink-dim">${escapeHtml(p.unit)}</p>
          </div>
          <span class="shrink-0 font-mono text-2xs text-ink-dim">${escapeHtml(fmtPrice(p.currentPrice))}</span>
        </li>`).join('');
    }

    async function refresh() {
      const list = await listProducts();
      const active = list.filter((p) => p.record_status === 'ACTIVE');
      renderStats(active);
      renderUnitBars(active);

      // Admins see the real audit trail; everyone else gets a catalogue
      // snapshot. The logs call is gracefully optional — a live demotion that
      // revokes ADM_USER simply falls back instead of erroring.
      if (session && isAdmin(session) && session.rights.has('ADM_USER')) {
        try {
          const logs = await getAdminLogs(8);
          activityTitle.textContent = 'Recent activity';
          activitySub.textContent = 'Latest administrative events.';
          renderActivityFromLogs(logs);
          return;
        } catch (e) { /* fall through to the catalogue view */ }
      }
      activityTitle.textContent = 'Catalogue overview';
      activitySub.textContent = 'Most recently changed products.';
      renderActivityFromProducts(active);
    }

    (async () => {
      session = await loadSession();
      try {
        await refresh();
      } catch (e) {
        activityList.innerHTML =
          `<li class="p-8 text-center text-sm text-accent-rose">${escapeHtml(e?.message ?? 'Failed to load the dashboard.')}</li>`;
      }
      // Listener: the dashboard reconciles on the shared products channel, so
      // a soft-delete / recover / add anywhere updates these figures live.
      startLiveRefresh(refresh, { intervalMs: 20000, channel: 'hopepms-products' });
    })().catch(console.error);
  </script>
</AppShell>

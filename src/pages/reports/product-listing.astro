---
import AppShell from '@layouts/AppShell.astro';
---
<AppShell title="Product Listing" subtitle="REP_001 · Active products with current price." requireRight="REP_001">
  <section class="space-y-6">
    <!-- ─── Summary strip ───────────────────────────────────────────── -->
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4 reveal">
      <div class="stat-card">
        <p class="stat-label">Products</p>
        <p class="stat-figure" data-stat="count">—</p>
        <p class="stat-sub">In the active catalogue.</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Distinct units</p>
        <p class="stat-figure" data-stat="units">—</p>
        <p class="stat-sub">pc · ea · mtr · pkg · ltr</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Price range</p>
        <p class="stat-figure-sm" data-stat="range">—</p>
        <p class="stat-sub">Lowest → highest current price.</p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Latest effective</p>
        <p class="stat-figure-sm" data-stat="latest">—</p>
        <p class="stat-sub">Most recent price change.</p>
      </div>
    </div>

    <!-- ─── Toolbar ─────────────────────────────────────────────────── -->
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
      <div class="relative flex-1 sm:max-w-md">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-ink-dim" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="search-input" type="search" placeholder="Filter by code or description…" class="field pl-9" />
      </div>
      <div class="flex items-center gap-3">
        <span class="text-xs text-ink-dim" data-result-count></span>
        <button id="csv-btn" class="btn-secondary">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export CSV
        </button>
      </div>
    </div>

    <!-- ─── Table ───────────────────────────────────────────────────── -->
    <div class="card !p-0 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr>
              <th><button data-sort="prodCode" class="inline-flex items-center gap-1 hover:text-ink transition-colors">Code <span class="sort-arrow text-ink-dim"></span></button></th>
              <th><button data-sort="description" class="inline-flex items-center gap-1 hover:text-ink transition-colors">Description <span class="sort-arrow text-ink-dim"></span></button></th>
              <th>Unit</th>
              <th class="text-right"><button data-sort="unitPrice" class="inline-flex items-center gap-1 hover:text-ink transition-colors">Price <span class="sort-arrow text-ink-dim"></span></button></th>
              <th class="text-right"><button data-sort="effDate" class="inline-flex items-center gap-1 hover:text-ink transition-colors">Effective <span class="sort-arrow text-ink-dim"></span></button></th>
            </tr>
          </thead>
          <tbody id="rows">
            {Array.from({ length: 6 }).map(() => (
              <tr>
                <td><div class="skeleton h-4 w-14"></div></td>
                <td><div class="skeleton h-4 w-56"></div></td>
                <td><div class="skeleton h-4 w-10"></div></td>
                <td><div class="skeleton h-4 w-16 ml-auto"></div></td>
                <td><div class="skeleton h-4 w-24 ml-auto"></div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div id="empty-state" class="hidden p-12 text-center">
        <div class="mx-auto h-12 w-12 rounded-2xl bg-white/5 flex items-center justify-center">
          <svg class="h-6 w-6 text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17v-6"/><path d="M12 17V7"/><path d="M15 17v-4"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
        </div>
        <p class="mt-3 font-display text-base font-medium" data-empty-title>No products to report</p>
        <p class="text-sm text-ink-dim" data-empty-hint>The active catalogue is empty.</p>
      </div>
    </div>
  </section>

  <script>
    // @ts-nocheck
    import { getProductReport } from '@lib/api/users';
    import { escapeHtml } from '@lib/security/sanitize';
    import { countUp } from '@lib/utils/animateNumber';

    const tbody = document.getElementById('rows');
    const emptyState = document.getElementById('empty-state');
    const search = document.getElementById('search-input');
    const resultCount = document.querySelector('[data-result-count]');

    let rows = [];
    let sortKey = 'prodCode';
    let sortDir = 1;

    const peso = new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' });
    function fmt(n) { return peso.format(Number(n)); }
    function debounce(fn, ms = 150) {
      let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
    }

    function currentView() {
      const q = (search.value || '').trim().toLowerCase();
      const filtered = !q ? rows : rows.filter((r) =>
        String(r.prodCode).toLowerCase().includes(q) ||
        String(r.description).toLowerCase().includes(q));
      return [...filtered].sort((a, b) => {
        const x = a[sortKey], y = b[sortKey];
        if (typeof x === 'number' && typeof y === 'number') return (x - y) * sortDir;
        return String(x).localeCompare(String(y)) * sortDir;
      });
    }

    function updateSortArrows() {
      document.querySelectorAll('[data-sort]').forEach((b) => {
        const arrow = b.querySelector('.sort-arrow');
        if (!arrow) return;
        arrow.textContent = b.getAttribute('data-sort') === sortKey ? (sortDir === 1 ? '↑' : '↓') : '';
      });
    }

    function updateStats() {
      const setText = (sel, v) => { const el = document.querySelector(sel); if (el) el.textContent = v; };
      countUp(document.querySelector('[data-stat="count"]'), rows.length);
      countUp(document.querySelector('[data-stat="units"]'), new Set(rows.map((r) => r.unit)).size || 0, { duration: 700 });
      if (rows.length) {
        const prices = rows.map((r) => Number(r.unitPrice)).filter((n) => !Number.isNaN(n));
        setText('[data-stat="range"]', prices.length ? `${fmt(Math.min(...prices))} – ${fmt(Math.max(...prices))}` : '—');
        const latest = rows.map((r) => r.effDate).sort((a, b) => String(b).localeCompare(String(a)))[0];
        setText('[data-stat="latest"]', latest ?? '—');
      } else {
        setText('[data-stat="range"]', '—');
        setText('[data-stat="latest"]', '—');
      }
    }

    function render() {
      const view = currentView();
      const q = (search.value || '').trim();

      if (rows.length === 0) {
        tbody.innerHTML = '';
        document.querySelector('[data-empty-title]').textContent = 'No products to report';
        document.querySelector('[data-empty-hint]').textContent = 'The active catalogue is empty.';
        emptyState.classList.remove('hidden');
      } else if (view.length === 0) {
        tbody.innerHTML = '';
        document.querySelector('[data-empty-title]').textContent = 'No matches';
        document.querySelector('[data-empty-hint]').textContent = `Nothing matches “${escapeHtml(q)}”.`;
        emptyState.classList.remove('hidden');
      } else {
        emptyState.classList.add('hidden');
        tbody.innerHTML = view.map((r) => `
          <tr>
            <td class="font-mono text-xs">${escapeHtml(r.prodCode)}</td>
            <td>${escapeHtml(r.description)}</td>
            <td><span class="chip-user">${escapeHtml(r.unit)}</span></td>
            <td class="text-right font-mono text-sm tabular-nums">${escapeHtml(fmt(r.unitPrice))}</td>
            <td class="text-right text-ink-muted text-xs font-mono">${escapeHtml(r.effDate)}</td>
          </tr>`).join('');
      }

      if (resultCount) {
        resultCount.textContent = rows.length
          ? (view.length === rows.length
              ? `${rows.length} ${rows.length === 1 ? 'product' : 'products'}`
              : `${view.length} of ${rows.length}`)
          : '';
      }
      updateSortArrows();
    }

    document.querySelectorAll('[data-sort]').forEach((b) => {
      b.addEventListener('click', () => {
        const k = b.getAttribute('data-sort');
        if (k === sortKey) sortDir = -sortDir; else { sortKey = k; sortDir = 1; }
        render();
      });
    });

    search.addEventListener('input', debounce(render, 150));

    document.getElementById('csv-btn')?.addEventListener('click', () => {
      const header = ['prodCode', 'description', 'unit', 'unitPrice', 'effDate'];
      const csv = [header.join(',')].concat(
        currentView().map((r) => header.map((h) => `"${String(r[h] ?? '').replace(/"/g, '""')}"`).join(',')),
      ).join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `product-listing-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
    });

    (async () => {
      try {
        rows = await getProductReport();
        updateStats();
        render();
      } catch (e) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-8 text-center text-sm text-accent-rose">${escapeHtml(e?.message ?? 'Failed to load.')}</td></tr>`;
      }
    })();
  </script>
</AppShell>

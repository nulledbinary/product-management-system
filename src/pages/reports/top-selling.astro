---
import AppShell from '@layouts/AppShell.astro';
---
<AppShell title="Top selling" subtitle="REP_002 · SUPERADMIN-only ranking by quantity sold." requireRight="REP_002">
  <section class="space-y-6">
    <div class="card">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-2xs font-semibold uppercase tracking-wider text-ink-muted">Window</p>
          <p class="font-display text-lg font-medium">All time · Top 10</p>
        </div>
        <div id="legend" class="text-xs text-ink-dim"></div>
      </div>
    </div>

    <div class="card">
      <ol id="bars" class="space-y-3">
        {Array.from({ length: 5 }).map(() => (
          <li class="skeleton h-10 rounded-xl"></li>
        ))}
      </ol>
    </div>
  </section>

  <script type="module">
    import { getTopSelling } from '/src/lib/api/users.ts';
    import { escapeHtml } from '/src/lib/security/sanitize.ts';

    const list = document.getElementById('bars');

    (async () => {
      try {
        const rows = await getTopSelling(10);
        if (!rows.length) {
          list.innerHTML = '<li class="text-center text-sm text-ink-dim py-8">No sales data yet.</li>';
          return;
        }
        const max = Math.max(...rows.map((r) => r.totalQty));
        list.innerHTML = rows.map((r, i) => {
          const pct = max > 0 ? Math.max(6, Math.round((r.totalQty / max) * 100)) : 6;
          return `
            <li class="relative overflow-hidden rounded-xl border border-line bg-white/[0.02] p-3">
              <div class="absolute inset-y-0 left-0 bg-brand-grad opacity-25" style="width:${pct}%"></div>
              <div class="relative flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                  <span class="inline-flex h-7 w-7 items-center justify-center rounded-lg bg-white/10 font-display text-sm">${i + 1}</span>
                  <div class="min-w-0">
                    <p class="font-mono text-xs text-ink-dim">${escapeHtml(r.prodCode)}</p>
                    <p class="text-sm truncate">${escapeHtml(r.description)}</p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="font-display text-lg font-semibold">${escapeHtml(String(r.totalQty))}</p>
                  <p class="text-2xs text-ink-dim uppercase tracking-wider">units</p>
                </div>
              </div>
            </li>`;
        }).join('');
        document.getElementById('legend').textContent = `Highest: ${max.toLocaleString()} units`;
      } catch (e) {
        list.innerHTML = `<li class="p-8 text-center text-sm text-accent-rose">${escapeHtml(e?.message ?? 'Failed.')}</li>`;
      }
    })();
  </script>
</AppShell>

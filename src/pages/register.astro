---
import BaseLayout from '@layouts/BaseLayout.astro';
import Logo from '@components/ui/Logo.astro';
---
<BaseLayout title="Create your HopePMS account" variant="hero">
  <main class="relative mx-auto flex min-h-screen w-full max-w-7xl items-center justify-center px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid w-full gap-10 lg:grid-cols-2 lg:gap-16">
      <section class="hidden flex-col justify-between lg:flex">
        <Logo />
        <div class="space-y-7">
          <span class="chip-admin">New account · Pending admin activation</span>
          <h1 class="font-display text-5xl font-semibold leading-[1.05] tracking-tight text-balance">
            Join the <span class="grad-text">HopePMS</span> team.
          </h1>
          <p class="max-w-md text-base leading-relaxed text-ink-muted">
            After you confirm your email, an administrator will activate your
            account before you can sign in. You'll receive standard
            <span class="text-ink">USER</span>-tier rights by default.
          </p>
          <div class="glass p-5">
            <p class="text-xs font-medium uppercase tracking-wider text-ink-muted">What happens next</p>
            <ol class="mt-3 space-y-2 text-sm text-ink-muted">
              <li><span class="text-brand-300 font-medium">1.</span> Confirm your email via the link we send you.</li>
              <li><span class="text-brand-300 font-medium">2.</span> An admin activates your account.</li>
              <li><span class="text-brand-300 font-medium">3.</span> Sign in and start managing products.</li>
            </ol>
          </div>
        </div>
        <p class="text-xs text-ink-dim">Already have an account? <a href="/login" class="text-brand-300 hover:text-brand-200">Sign in.</a></p>
      </section>

      <section class="flex items-center justify-center">
        <div class="glass-strong w-full max-w-md p-8 sm:p-10 animate-fade-in">
          <div class="mb-6 lg:hidden"><Logo /></div>
          <header class="mb-7">
            <h2 class="font-display text-2xl font-semibold tracking-tight">Create your account</h2>
            <p class="mt-1 text-sm text-ink-muted">It only takes a moment.</p>
          </header>

          <form id="register-form" class="space-y-4" novalidate autocomplete="on">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="firstName" class="field-label">First name</label>
                <input id="firstName" name="firstName" class="field" required maxlength="50" />
                <p class="field-error hidden" data-error="firstName"></p>
              </div>
              <div>
                <label for="lastName" class="field-label">Last name</label>
                <input id="lastName" name="lastName" class="field" required maxlength="50" />
                <p class="field-error hidden" data-error="lastName"></p>
              </div>
            </div>

            <div>
              <label for="username" class="field-label">Username</label>
              <input id="username" name="username" class="field" required minlength="3" maxlength="32" />
              <p class="field-help">Letters, numbers, dot, dash, underscore. 3–32 chars.</p>
              <p class="field-error hidden" data-error="username"></p>
            </div>

            <div>
              <label for="email" class="field-label">Work email</label>
              <input id="email" name="email" type="email" class="field" required autocomplete="username" />
              <p class="field-error hidden" data-error="email"></p>
            </div>

            <div>
              <label for="password" class="field-label">Password</label>
              <input id="password" name="password" type="password" class="field" required minlength="10" autocomplete="new-password" />
              <p class="field-help">Minimum 10 characters. Use a passphrase.</p>
              <p class="field-error hidden" data-error="password"></p>
            </div>

            <button type="submit" class="btn-primary w-full">Create account</button>
          </form>

          <div class="my-6 divider-text"><span>or</span></div>
          <button type="button" id="google-btn" class="btn-secondary w-full">
            <img src="/google-icon.svg" alt="" width="16" height="16" />
            Register with Google
          </button>

          <p class="mt-7 text-center text-sm text-ink-muted">
            Already a member?
            <a href="/login" class="font-medium text-brand-300 hover:text-brand-200">Sign in</a>
          </p>
        </div>
      </section>
    </div>
  </main>

  <script>
    // @ts-nocheck
    import { loginWithGoogle } from '@lib/auth/auth0Client';
    import { matchOrThrow, PATTERNS, safeText, ValidationError } from '@lib/security/pathGuard';

    const form = document.getElementById('register-form');

    function show(field, msg) {
      const el = document.querySelector(`[data-error="${field}"]`);
      if (!el) return;
      el.textContent = msg;
      el.classList.toggle('hidden', !msg);
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      ['firstName','lastName','username','email','password'].forEach((f) => show(f, ''));

      const data = new FormData(form);
      let firstName, lastName, username, email, password;
      try {
        firstName = safeText(data.get('firstName'), 'firstName', 50);
        lastName  = safeText(data.get('lastName'),  'lastName',  50);
        username  = matchOrThrow(data.get('username'), PATTERNS.username, 'username');
        email     = matchOrThrow(data.get('email'),    PATTERNS.email,    'email');
        password  = String(data.get('password') || '');
        matchOrThrow(firstName, PATTERNS.name, 'firstName');
        matchOrThrow(lastName,  PATTERNS.name, 'lastName');
        if (password.length < 10) throw new ValidationError('password', 'Password must be ≥ 10 characters.');
      } catch (err) {
        if (err instanceof ValidationError) {
          show(err.field, err.message);
        }
        return;
      }

      // Hand off to Auth0 Universal Login — registration is a managed flow.
      // The provisioning trigger on the Lambda side creates the USER/INACTIVE row.
      try {
        const { getClient } = await import('@lib/auth/auth0Client');
        const client = await getClient();
        await client.loginWithRedirect({
          authorizationParams: {
            screen_hint: 'signup',
            login_hint: email,
          },
          appState: { firstName, lastName, username },
        });
      } catch (err) {
        console.error(err);
        show('password', 'Could not start registration. Try again.');
      }
      password = ''; // wipe local reference
    });

    document.getElementById('google-btn')?.addEventListener('click', () => loginWithGoogle());
  </script>
</BaseLayout>

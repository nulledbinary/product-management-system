---
import BaseLayout from '@layouts/BaseLayout.astro';
import Logo from '@components/ui/Logo.astro';
---
<BaseLayout title="Create your HopePMS account" variant="hero">
  <main class="relative mx-auto flex min-h-screen w-full max-w-[1100px] items-stretch px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid w-full items-center gap-10 lg:grid-cols-2 lg:gap-20">
      <!-- Branding panel — Vision UI's full-height side panel, monochromed. -->
      <section class="relative hidden min-h-[680px] overflow-hidden rounded-[28px] border border-line lg:block">
        <div class="absolute inset-0 bg-mesh-hero opacity-90"></div>
        <div class="absolute inset-0 [background-image:linear-gradient(rgba(255,255,255,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.05)_1px,transparent_1px)] [background-size:54px_54px] [mask-image:radial-gradient(75%_70%_at_50%_40%,#000_30%,transparent_78%)]"></div>
        <div class="absolute -bottom-40 left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-white/[0.06] blur-3xl"></div>

        <div class="relative flex h-full flex-col justify-between p-10">
          <Logo href={null} />

          <div class="flex flex-col items-center text-center">
            <span class="text-2xs font-semibold uppercase tracking-[0.42em] text-ink-dim">
              New account · Pending admin activation
            </span>
            <h1 class="mt-6 font-display text-5xl font-semibold leading-[1.05] tracking-tight">
              Join the <span class="grad-text">HopePMS</span><br />team.
            </h1>
            <p class="mt-5 max-w-sm text-sm leading-relaxed text-ink-muted">
              After you confirm your email, an administrator will activate your
              account before you can sign in. You'll receive standard
              <span class="text-ink">USER</span>-tier rights by default.
            </p>
          </div>

          <div class="rounded-2xl border border-line bg-white/[0.03] p-5">
            <p class="text-2xs font-semibold uppercase tracking-wider text-ink-muted">What happens next</p>
            <ol class="mt-3 space-y-2 text-sm text-ink-muted">
              <li><span class="font-mono font-semibold text-ink">1.</span> Confirm your email via the link we send you.</li>
              <li><span class="font-mono font-semibold text-ink">2.</span> An admin activates your account.</li>
              <li><span class="font-mono font-semibold text-ink">3.</span> Sign in and start managing products.</li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Form column — Vision UI wraps the sign-up form in a gradient-bordered card. -->
      <section class="flex flex-col justify-center">
        <div class="mx-auto w-full max-w-md">
          <div class="mb-8 lg:hidden"><Logo href={null} /></div>

          <header class="mb-7 text-center">
            <h2 class="font-display text-[32px] font-semibold leading-tight tracking-tight">Create your account</h2>
            <p class="mt-2 text-sm font-medium text-ink-muted">You'll set your password on Auth0's hosted signup page.</p>
          </header>

          <div class="grad-border rounded-[30px]">
            <div class="rounded-[29px] bg-bg-surface p-8 sm:p-10">
              <p class="mb-5 text-center text-base font-bold text-ink-muted">Register with</p>

              <button type="button" id="google-btn"
                      class="btn-secondary w-full !rounded-[20px] !py-3.5">
                <img src="/google-icon.svg" alt="" width="16" height="16" />
                Register with Google
              </button>

              <div class="my-6 divider-text"><span>or</span></div>

              <form id="register-form" class="space-y-5" novalidate autocomplete="on">
                <div>
                  <label for="email" class="field-label">Work email</label>
                  <div class="grad-border rounded-[20px]">
                    <input id="email" name="email" type="email" required autocomplete="username"
                           placeholder="you@hope.inc"
                           class="block w-full rounded-[19px] bg-bg-deep px-5 py-3.5 text-sm text-ink placeholder:text-ink-dim focus:outline-none" />
                  </div>
                  <p class="field-error hidden" data-error="email"></p>
                </div>

                <button type="submit"
                        class="btn-primary w-full !rounded-[20px] !py-3.5 text-xs font-bold uppercase tracking-[0.18em]">
                  Continue to sign up
                </button>
              </form>

              <p class="mt-7 text-center text-sm font-medium text-ink-muted">
                Already a member?
                <a href="/login" class="ms-1 font-bold text-ink underline decoration-white/30 underline-offset-4 transition-colors hover:decoration-white">Sign in</a>
              </p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script>
    // @ts-nocheck
    import { startLogin } from '@lib/auth/volatileSession';
    import { matchOrThrow, PATTERNS, ValidationError } from '@lib/security/pathGuard';

    const form = document.getElementById('register-form');

    function show(field, msg) {
      const el = document.querySelector(`[data-error="${field}"]`);
      if (!el) return;
      el.textContent = msg;
      el.classList.toggle('hidden', !msg);
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      show('email', '');

      const data = new FormData(form);
      let email;
      try {
        email = matchOrThrow(data.get('email'), PATTERNS.email, 'email');
      } catch (err) {
        if (err instanceof ValidationError) show(err.field, err.message);
        return;
      }

      startLogin({ screenHint: 'signup', loginHint: email });
    });

    document.getElementById('google-btn')?.addEventListener('click', () => {
      startLogin({ connection: 'google-oauth2', screenHint: 'signup' });
    });
  </script>
</BaseLayout>

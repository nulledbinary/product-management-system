---
import BaseLayout from '@layouts/BaseLayout.astro';
import Logo from '@components/ui/Logo.astro';

const reason = Astro.url.searchParams.get('reason');
const reasonText: Record<string, string> = {
  timeout: 'Your session timed out for inactivity. Please sign in again.',
  not_activated: 'Your account is pending administrator activation.',
  auth_required: 'Please sign in to continue.',
  forbidden: 'You do not have access to that page.',
  guard_error: 'We could not verify your session — please sign in again.',
  invalid_state: 'Your sign-in session expired. Please try again.',
  auth0_token_failed: 'We could not complete sign-in. Please try again.',
};
const banner = reason ? reasonText[reason] : null;
---
<BaseLayout title="Sign in · HopePMS" variant="hero">
  <main class="relative mx-auto flex min-h-screen w-full max-w-7xl items-center justify-center px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid w-full gap-10 lg:grid-cols-2 lg:gap-16">
      <section class="hidden flex-col justify-between lg:flex">
        <Logo href={null} />

        <div class="space-y-8">
          <div class="space-y-5">
            <span class="chip-user">Secure · Role-aware · Audit-stamped</span>
            <h1 class="font-display text-5xl font-semibold leading-[1.05] tracking-tight text-balance">
              Manage your product universe with
              <span class="grad-text">surgical precision</span>.
            </h1>
            <p class="max-w-md text-base leading-relaxed text-ink-muted text-pretty">
              Role-aware, audit-stamped, and zero-hard-delete by design. Built on
              Astro &amp; AWS — secured by Auth0, ready for production.
            </p>
          </div>

          <ul class="grid max-w-md gap-3 sm:grid-cols-2">
            {[
              ['Auth0 + Google SSO', 'M9 12l2 2 4-4'],
              ['Server-side sessions', 'M12 2a5 5 0 0 0-5 5v3H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2h-1V7a5 5 0 0 0-5-5z'],
              ['Per-right access control', 'M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z'],
              ['Soft-delete & recovery', 'M3 7h18M9 7V4h6v3M6 7l1 14h10l1-14'],
            ].map(([label, d]) => (
              <li class="glass flex items-center gap-3 !rounded-xl px-4 py-3">
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-brand-500/15 text-brand-300">
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={d} /></svg>
                </span>
                <span class="text-sm font-medium text-ink-muted">{label}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="flex items-center justify-center">
        <div class="glass-strong w-full max-w-md p-8 sm:p-10 animate-fade-in">
          <div class="mb-6 lg:hidden"><Logo href={null} /></div>

          <header class="mb-7">
            <h2 class="font-display text-2xl font-semibold tracking-tight">Welcome back</h2>
            <p class="mt-1 text-sm text-ink-muted">Sign in to access HopePMS.</p>
          </header>

          {banner && (
            <div role="alert" class="mb-5 rounded-xl border border-accent-amber/30 bg-accent-amber/10 px-4 py-3 text-sm text-accent-amber">
              {banner}
            </div>
          )}

          <form id="login-form" class="space-y-4" novalidate autocomplete="on">
            <div>
              <label for="email" class="field-label">Work email</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="username"
                required
                placeholder="you@hope.inc"
                class="field"
              />
              <p class="field-error hidden" data-error="email"></p>
            </div>

            <button type="submit" id="email-submit" class="btn-primary w-full">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><polyline points="12 5 19 12 12 19"/></svg>
              Continue
            </button>
            <p class="text-xs text-ink-dim text-center">
              You'll enter your password on Auth0's hosted page.
            </p>
          </form>

          <div class="my-6 divider-text"><span>or</span></div>

          <button type="button" id="google-btn" class="btn-secondary w-full">
            <img src="/google-icon.svg" alt="" width="16" height="16" />
            Sign in with Google
          </button>

          <p class="mt-7 text-center text-sm text-ink-muted">
            Don't have an account?
            <a href="/register" class="font-medium text-brand-300 hover:text-brand-200 transition-colors">Register</a>
          </p>
        </div>
      </section>
    </div>
  </main>

  <script>
    // @ts-nocheck
    import { startLogin } from '@lib/auth/volatileSession';
    import { hasTraversal } from '@lib/security/pathGuard';

    const form = document.getElementById('login-form');
    const emailInput = document.getElementById('email');
    const errEmail = document.querySelector('[data-error="email"]');

    function setError(el, msg) {
      if (!el) return;
      el.textContent = msg;
      el.classList.toggle('hidden', !msg);
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      setError(errEmail, '');

      const email = String(emailInput.value || '').trim();
      if (!/^[^\s@]{1,64}@[^\s@]{1,255}\.[^\s@]{2,24}$/.test(email)) {
        setError(errEmail, 'Enter a valid email.');
        return;
      }
      if (hasTraversal(email)) {
        setError(errEmail, 'Invalid characters in input.');
        return;
      }

      startLogin({ loginHint: email });
    });

    document.getElementById('google-btn')?.addEventListener('click', () => {
      startLogin({ connection: 'google-oauth2' });
    });
  </script>
</BaseLayout>

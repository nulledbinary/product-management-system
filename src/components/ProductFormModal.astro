---
interface Props { id: string; mode: 'add' | 'edit'; }
const { id, mode } = Astro.props;
const isAdd = mode === 'add';
---
<div id={`${id}-backdrop`} class="modal-backdrop hidden" data-modal-backdrop={id}></div>
<div id={id} role="dialog" aria-modal="true" aria-labelledby={`${id}-title`} class="modal-panel hidden" data-modal={id}>
  <button type="button" class="absolute right-4 top-4 btn-ghost h-9 w-9 !p-0" data-modal-close={id} aria-label="Close">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>

  <header class="mb-5">
    <h2 id={`${id}-title`} class="font-display text-xl font-semibold tracking-tight">
      {isAdd ? 'Add product' : 'Edit product'}
    </h2>
    <p class="mt-1 text-sm text-ink-muted">
      {isAdd
        ? 'Create a new product and set its initial price.'
        : 'Update the description, unit, or current price. Past prices remain on file.'}
    </p>
  </header>

  <form class="space-y-4" data-product-form={mode} novalidate>
    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="field-label">Product code</label>
        <input name="prodCode" class="field uppercase tracking-wider" required maxlength="6"
               pattern="[A-Z0-9]{2,6}" placeholder="AK0001" {...(isAdd ? {} : { readonly: true })} />
        <p class="field-error hidden" data-error="prodCode"></p>
      </div>
      <div>
        <label class="field-label">Unit</label>
        <select name="unit" class="field" required>
          <option value="">—</option>
          <option value="pc">pc</option>
          <option value="ea">ea</option>
          <option value="mtr">mtr</option>
          <option value="pkg">pkg</option>
          <option value="ltr">ltr</option>
        </select>
        <p class="field-error hidden" data-error="unit"></p>
      </div>
    </div>

    <div>
      <label class="field-label">Description</label>
      <input name="description" class="field" required maxlength="30" placeholder="Hammer 1lb" />
      <p class="field-help">Up to 30 characters. No markup, no path sequences.</p>
      <p class="field-error hidden" data-error="description"></p>
    </div>

    <div>
      <label class="field-label">Unit price</label>
      <div class="relative">
        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-ink-dim">₱</span>
        <input name="unitPrice" type="number" inputmode="decimal" step="0.01" min="0.01" max="9999999.99"
               class="field pl-9" required placeholder="0.00" />
      </div>
      <p class="field-error hidden" data-error="unitPrice"></p>
    </div>

    <div class="flex items-center justify-end gap-2 pt-2">
      <button type="button" class="btn-secondary" data-modal-close={id}>Cancel</button>
      <button type="submit" class="btn-primary">
        {isAdd ? 'Create product' : 'Save changes'}
      </button>
    </div>
  </form>
</div>

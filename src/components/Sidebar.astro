---
import Logo from './ui/Logo.astro';
const path = Astro.url.pathname;
function isActive(p: string): boolean {
  if (p === '/products') return path === '/products' || path.startsWith('/products/');
  return path === p;
}
---
<aside
  id="app-sidebar"
  class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-line bg-bg-deep/60 backdrop-blur-xl px-4 py-5 lg:flex"
>
  <div class="px-2 pb-6"><Logo /></div>

  <nav class="flex flex-col gap-1" data-nav>
    <p class="px-3 pb-1.5 text-2xs font-semibold uppercase tracking-wider text-ink-dim">Products</p>
    <a href="/products" class={isActive('/products') ? 'nav-item-active' : 'nav-item'}>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 12l9 4 9-4"/><path d="M3 17l9 4 9-4"/></svg>
      Product List
    </a>
    <a href="/products/deleted" data-right="deleted" class={isActive('/products/deleted') ? 'nav-item-active hidden' : 'nav-item hidden'}>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
      Deleted Items
    </a>

    <p class="mt-5 px-3 pb-1.5 text-2xs font-semibold uppercase tracking-wider text-ink-dim">Reports</p>
    <a href="/reports/product-listing" data-right="REP_001" class={isActive('/reports/product-listing') ? 'nav-item-active hidden' : 'nav-item hidden'}>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17v-6"/><path d="M12 17V7"/><path d="M15 17v-4"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
      Product Listing
    </a>
    <a href="/reports/top-selling" data-right="REP_002" class={isActive('/reports/top-selling') ? 'nav-item-active hidden' : 'nav-item hidden'}>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>
      Top Selling
    </a>

    <p class="mt-5 px-3 pb-1.5 text-2xs font-semibold uppercase tracking-wider text-ink-dim">Admin</p>
    <a href="/admin/users" data-right="ADM_USER" class={isActive('/admin/users') ? 'nav-item-active hidden' : 'nav-item hidden'}>
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
      Manage Users
    </a>
  </nav>

  <div class="mt-auto pt-6">
    <div class="glass-strong p-4">
      <p class="text-2xs font-semibold uppercase tracking-wider text-ink-muted">Signed in as</p>
      <p class="mt-1.5 text-sm font-medium truncate" data-username>—</p>
      <p class="mt-0.5 text-xs text-ink-dim" data-usertype>—</p>
      <button id="signout-btn" class="btn-ghost mt-3 w-full justify-center text-xs">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign out
      </button>
    </div>
  </div>
</aside>

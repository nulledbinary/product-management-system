---
import Logo from './ui/Logo.astro';
---
<aside
  id="app-sidebar"
  class="fixed inset-y-0 left-0 z-30 hidden w-64 flex-col border-r border-line bg-bg-deep/70 backdrop-blur-xl px-4 py-5 lg:flex"
>
  <div class="px-2 pb-6"><Logo /></div>

  <nav class="relative flex flex-col gap-1" data-nav>
    <span id="nav-indicator" class="opacity-0" aria-hidden="true"></span>

    <p class="px-3 pb-1.5 text-2xs font-semibold uppercase tracking-wider text-ink-dim">Products</p>
    <a href="/products" class="nav-item" data-navlink="/products">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 12l9 4 9-4"/><path d="M3 17l9 4 9-4"/></svg>
      Product List
    </a>
    <a href="/products/deleted" data-right="deleted" data-navlink="/products/deleted" class="nav-item hidden">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
      Deleted Items
    </a>

    <p class="mt-5 px-3 pb-1.5 text-2xs font-semibold uppercase tracking-wider text-ink-dim">Reports</p>
    <a href="/reports/product-listing" data-right="REP_001" data-navlink="/reports/product-listing" class="nav-item hidden">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 17v-6"/><path d="M12 17V7"/><path d="M15 17v-4"/><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
      Product Listing
    </a>
    <a href="/reports/top-selling" data-right="REP_002" data-navlink="/reports/top-selling" class="nav-item hidden">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="14 7 21 7 21 14"/></svg>
      Top Selling
    </a>

    <p class="mt-5 px-3 pb-1.5 text-2xs font-semibold uppercase tracking-wider text-ink-dim">Admin</p>
    <a href="/admin/users" data-right="ADM_USER" data-navlink="/admin/users" class="nav-item hidden">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
      Manage Users
    </a>
    <a href="/admin/logs" data-right="ADM_USER" data-navlink="/admin/logs" class="nav-item hidden">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 2"/><circle cx="12" cy="12" r="9"/></svg>
      Activity Log
    </a>
    <a href="/admin/superadmins" data-owner data-navlink="/admin/superadmins" class="nav-item hidden">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9.5 12l2 2 3.5-4"/></svg>
      SUPERADMIN Control
    </a>
  </nav>

  <div class="mt-auto pt-6">
    <div class="glass-strong p-4">
      <p class="text-2xs font-semibold uppercase tracking-wider text-ink-muted">Signed in as</p>
      <p class="mt-1.5 text-sm font-medium truncate" data-username>—</p>
      <p class="mt-0.5 text-xs text-ink-dim" data-usertype>—</p>
      <button id="signout-btn" class="btn-ghost mt-3 w-full justify-center text-xs">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Sign out
      </button>
    </div>
  </div>
</aside>

<script>
  // @ts-nocheck
  // Dynamic, animated active indicator — follows the real route client-side
  // and glides to whatever link the cursor is hovering, then snaps back.
  (function () {
    const nav = document.querySelector('[data-nav]');
    if (!nav) return;
    const indicator = nav.querySelector('#nav-indicator');
    const links = Array.from(nav.querySelectorAll('[data-navlink]'));

    function activeLink() {
      const path = window.location.pathname.replace(/\/+$/, '') || '/';
      let best = null;
      let bestLen = -1;
      for (const a of links) {
        const href = a.getAttribute('data-navlink');
        const match = path === href || path.startsWith(href + '/');
        if (match && href.length > bestLen) { best = a; bestLen = href.length; }
      }
      return best;
    }

    function moveTo(el) {
      if (!el || !indicator) return;
      indicator.style.top = el.offsetTop + 6 + 'px';
      indicator.style.height = Math.max(0, el.offsetHeight - 12) + 'px';
      indicator.classList.remove('opacity-0');
    }

    function paint() {
      const current = activeLink();
      links.forEach((a) => a.classList.toggle('nav-item-active', a === current));
      if (current) moveTo(current);
      else if (indicator) indicator.classList.add('opacity-0');
    }

    links.forEach((a) => {
      a.addEventListener('mouseenter', () => moveTo(a));
    });
    nav.addEventListener('mouseleave', () => moveTo(activeLink()));

    // Re-run after rights-gated links are un-hidden by AppShell, and on resize.
    requestAnimationFrame(paint);
    setTimeout(paint, 400);
    window.addEventListener('resize', paint);
    window.addEventListener('pageshow', paint);
  })();
</script>

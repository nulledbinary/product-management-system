---
interface Props {
  id: string;
  title: string;
  message: string;
  confirmLabel?: string;
  variant?: 'danger' | 'primary';
}
const { id, title, message, confirmLabel = 'Confirm', variant = 'primary' } = Astro.props;
---
<div id={`${id}-backdrop`} class="modal-backdrop hidden" data-modal-backdrop={id}></div>
<div id={id} role="alertdialog" aria-modal="true" aria-labelledby={`${id}-title`} class="modal-panel hidden" data-modal={id}>
  <h2 id={`${id}-title`} class="font-display text-lg font-semibold">{title}</h2>
  <p class="mt-2 text-sm text-ink-muted" data-confirm-message>{message}</p>
  <div class="mt-6 flex items-center justify-end gap-2">
    <button type="button" class="btn-secondary" data-modal-close={id}>Cancel</button>
    <button type="button" class={variant === 'danger' ? 'btn-danger' : 'btn-primary'} data-confirm={id}>{confirmLabel}</button>
  </div>
</div>

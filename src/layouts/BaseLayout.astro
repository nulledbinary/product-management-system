---
import '@styles/global.css';
interface Props {
  title?: string;
  description?: string;
  variant?: 'hero' | 'app';
}
const {
  title = 'HopePMS — Product Management',
  description = 'Secure, role-aware product management for Hope, Inc.',
  variant = 'app',
} = Astro.props;
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#05070f" />

    <link rel="preconnect" href="https://rsms.me/" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={variant === 'hero' ? 'overflow-x-hidden' : ''}>
    {variant === 'hero' && (
      <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute -top-40 left-1/2 h-[680px] w-[1100px] -translate-x-1/2 rounded-full bg-mesh-hero blur-[60px] opacity-90"></div>
        <div class="absolute bottom-[-200px] right-[-160px] h-[420px] w-[420px] rounded-full bg-accent-violet/15 blur-3xl"></div>
        <div class="absolute top-[40%] left-[-120px] h-[380px] w-[380px] rounded-full bg-brand-500/15 blur-3xl"></div>
      </div>
    )}
    <slot />

    <noscript>
      <div class="fixed inset-x-0 top-0 z-50 bg-accent-rose/20 backdrop-blur p-3 text-center text-sm">
        HopePMS requires JavaScript to enforce its session security model. Please enable JavaScript.
      </div>
    </noscript>
  </body>
</html>

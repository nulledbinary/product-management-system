---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@components/Sidebar.astro';
import TopBar from '@components/TopBar.astro';

interface Props {
  title: string;
  subtitle?: string;
  requireRight?: string;
  requireAdmin?: boolean;
  requireOwner?: boolean;
}
const { title, subtitle, requireRight, requireAdmin, requireOwner } = Astro.props;
---
<BaseLayout title={`${title} · HopePMS`} description={subtitle ?? 'HopePMS'} variant="app">
  <!-- Opaque boot cover: nothing behind it paints until the session is
       resolved, so an unauthenticated visitor never sees the app chrome. -->
  <div id="boot-splash" class="fixed inset-0 z-[100] flex flex-col items-center justify-center gap-5 bg-bg-deep">
    <span class="relative inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-black shadow-glow">
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
        <path d="M6 4h2.8v6.6h6.4V4H18v16h-2.8v-7.2H8.8V20H6z"/>
      </svg>
      <span class="absolute -inset-2 rounded-3xl bg-white/20 blur-xl animate-pulse-glow"></span>
    </span>
    <div class="flex items-center gap-1.5" aria-label="Loading">
      <span class="h-1.5 w-1.5 rounded-full bg-ink-muted animate-dot"></span>
      <span class="h-1.5 w-1.5 rounded-full bg-ink-muted animate-dot [animation-delay:200ms]"></span>
      <span class="h-1.5 w-1.5 rounded-full bg-ink-muted animate-dot [animation-delay:400ms]"></span>
    </div>
    <p class="text-2xs uppercase tracking-[0.22em] text-ink-dim">Verifying session</p>
  </div>

  <div id="app-shell" class="opacity-0 transition-opacity duration-500">
    <Sidebar />

    <main class="min-h-screen lg:pl-64">
      <TopBar title={title} subtitle={subtitle} />
      <div id="app-main" class="px-4 py-6 sm:px-6 lg:px-8">
        <slot />
      </div>
    </main>
  </div>

  <div id="logout-toast" class="fixed bottom-6 left-1/2 z-50 hidden -translate-x-1/2 glass-strong px-4 py-3 text-sm shadow-glow">
    Session timed out — please sign in again.
  </div>

  <!-- ─── Global notice dialog ──────────────────────────────────────────
       A single accessible modal that replaces every window.alert(). Pages
       call window.hopeNotify(message, { title, variant }). It sits above
       regular .modal-panel modals so a failure raised while another modal
       is open is still readable. -->
  <div id="notice-backdrop" class="modal-backdrop hidden !z-[60]" data-notice-backdrop></div>
  <div id="notice" role="alertdialog" aria-modal="true" aria-labelledby="notice-title"
       aria-describedby="notice-msg" class="modal-panel hidden !z-[70] !w-[min(420px,92vw)]"
       data-notice tabindex="-1">
    <div class="flex items-start gap-3">
      <span id="notice-icon" class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="13" /><line x1="12" y1="16.5" x2="12.01" y2="16.5" />
        </svg>
      </span>
      <div class="min-w-0 flex-1">
        <h2 id="notice-title" class="font-display text-base font-semibold tracking-tight">Something went wrong</h2>
        <p id="notice-msg" class="mt-1.5 text-sm leading-relaxed text-ink-muted break-words"></p>
      </div>
    </div>
    <div class="mt-6 flex justify-end">
      <button type="button" id="notice-ok" class="btn-primary h-9 px-5 text-sm">Got it</button>
    </div>
  </div>

  <script is:inline>
    /* No imports — runs in document order so window.hopeNotify is defined
       before any deferred page module can call it. */
    (function () {
      var backdrop = document.getElementById('notice-backdrop');
      var panel = document.getElementById('notice');
      var iconWrap = document.getElementById('notice-icon');
      var titleEl = document.getElementById('notice-title');
      var msgEl = document.getElementById('notice-msg');
      var okBtn = document.getElementById('notice-ok');
      if (!panel || !backdrop) return;

      var lastFocus = null;
      var VARIANTS = {
        error:   { title: 'Something went wrong', cls: 'bg-accent-rose/15 text-accent-rose' },
        success: { title: 'Done',                 cls: 'bg-accent-mint/15 text-accent-mint' },
        info:    { title: 'Heads up',             cls: 'bg-white/10 text-ink' },
      };

      function hide() {
        panel.classList.add('hidden');
        backdrop.classList.add('hidden');
        document.removeEventListener('keydown', onKey);
        if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (e) {} }
        lastFocus = null;
      }
      function onKey(e) {
        if (e.key === 'Escape' || e.key === 'Enter') { e.preventDefault(); hide(); }
      }

      window.hopeNotify = function (message, opts) {
        opts = opts || {};
        var v = VARIANTS[opts.variant] || VARIANTS.error;
        titleEl.textContent = opts.title || v.title;
        msgEl.textContent = message == null || message === ''
          ? 'An unexpected error occurred. Please try again.'
          : String(message);
        iconWrap.className =
          'mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl ' + v.cls;
        lastFocus = document.activeElement;
        backdrop.classList.remove('hidden');
        panel.classList.remove('hidden');
        document.addEventListener('keydown', onKey);
        try { okBtn.focus(); } catch (e) {}
      };

      okBtn.addEventListener('click', hide);
      backdrop.addEventListener('click', hide);
    })();
  </script>

  <script
    is:inline
    define:vars={{ requireRight, requireAdmin, requireOwner }}
  >
    window.__HOPEPMS_GUARD__ = { requireRight: requireRight ?? null, requireAdmin: !!requireAdmin, requireOwner: !!requireOwner };
  </script>

  <script>
    // @ts-nocheck
    import { fetchIdentity, signOut, startIdentityWatch, $session } from '@lib/auth/volatileSession';
    import {
      startInactivityWatchdog,
      sessionTimeoutMs,
      lastTouchedAt,
      touch,
    } from '@lib/security/timeout';

    const { requireRight, requireAdmin, requireOwner } = window.__HOPEPMS_GUARD__ || {};
    const shell = document.getElementById('app-shell');
    const splash = document.getElementById('boot-splash');
    const sidebar = document.getElementById('app-sidebar');
    const toast = document.getElementById('logout-toast');
    const toggle = document.getElementById('sidebar-toggle');
    const timerEl = document.querySelector('[data-timer]');

    function redirect(target) {
      window.location.replace(target);
    }

    const isAdmin = (s) => s.userType === 'ADMIN' || s.userType === 'SUPERADMIN';

    // Does this session satisfy THIS page's access requirements?
    function authorizedFor(session) {
      if (requireAdmin && !isAdmin(session)) return false;
      if (requireRight && !session.rights.has(requireRight)) return false;
      if (requireOwner && session.owner !== true) return false;
      return true;
    }

    // Reconcile every access-gated bit of chrome to the CURRENT session.
    // Critically this both reveals AND hides — a live demotion has to remove
    // links/buttons, not just fail to add them — so it is safe to call
    // repeatedly as the role changes underneath an open tab.
    function applyAccess(session) {
      document.querySelectorAll('[data-username]').forEach((el) => { el.textContent = session.username; });
      document.querySelectorAll('[data-usertype]').forEach((el) => { el.textContent = session.userType; });

      document.querySelectorAll('[data-right]').forEach((el) => {
        const r = el.getAttribute('data-right');
        const visible = r === 'deleted' ? isAdmin(session) : session.rights.has(r);
        el.classList.toggle('hidden', !visible);
      });
      document.querySelectorAll('[data-owner]').forEach((el) => {
        el.classList.toggle('hidden', session.owner !== true);
      });

      // Let the sidebar's active-indicator recompute now that the set of
      // visible links may have changed.
      window.dispatchEvent(new Event('resize'));
    }

    // The boot guard must NOT hard-logout on a single transient /api/auth/me
    // blip — that is the "every time the dashboard changes I get logged out"
    // bug. Retry the indeterminate case a few times with backoff; only a
    // definitive 401 (or a backend that stays unreachable across every retry)
    // ever sends the user to /login. A valid session simply rides it out.
    async function resolveSession() {
      const delays = [0, 400, 900, 1600];
      for (let i = 0; i < delays.length; i++) {
        if (delays[i]) await new Promise((r) => setTimeout(r, delays[i]));
        const probe = await fetchIdentity();
        if (probe.status === 'ok') {
          $session.set(probe.identity);
          return { ok: true, session: probe.identity };
        }
        if (probe.status === 'unauthenticated') {
          $session.set(null);
          return { ok: false, reason: 'auth_required' };
        }
        // 'unavailable' → transient; fall through and retry.
      }
      // Persistently unreachable: not "logged out", but we genuinely cannot
      // render the app, so surface the softer guard_error reason instead.
      return { ok: false, reason: 'guard_error' };
    }

    async function bootstrap() {
      const resolved = await resolveSession();
      if (!resolved.ok) return redirect(`/login?reason=${resolved.reason}`);
      const session = resolved.session;

      if (!authorizedFor(session)) return redirect('/dashboard?reason=forbidden');

      applyAccess(session);

      document.getElementById('signout-btn')?.addEventListener('click', async () => {
        await signOut();
      });

      toggle?.addEventListener('click', () => {
        sidebar?.classList.toggle('flex');
        sidebar?.classList.toggle('hidden');
      });

      startInactivityWatchdog(() => {
        if (toast) {
          toast.classList.remove('hidden');
          toast.classList.add('animate-fade-in');
        }
        setTimeout(() => redirect('/login?reason=timeout'), 1200);
      });

      const total = sessionTimeoutMs();
      function renderTimer() {
        const remaining = Math.max(0, total - (Date.now() - lastTouchedAt()));
        const mm = String(Math.floor(remaining / 60000)).padStart(2, '0');
        const ss = String(Math.floor((remaining % 60000) / 1000)).padStart(2, '0');
        if (timerEl) timerEl.textContent = `${mm}:${ss}`;
      }
      touch();
      renderTimer();
      setInterval(renderTimer, 1000);

      // Authorized: reveal the shell, then dissolve the boot cover.
      shell?.classList.remove('opacity-0');
      if (splash) {
        splash.style.transition = 'opacity 320ms ease';
        splash.style.opacity = '0';
        setTimeout(() => splash.remove(), 360);
      }

      // Real-time identity reconcile. The backend resolves rights live per
      // request; this notices a promote/demote/right-grant and re-gates the
      // chrome in place, or — if the account was deactivated/deleted, or this
      // page now exceeds the new permissions — bounces the user out. No reload.
      startIdentityWatch({
        onChange(next) {
          if (!authorizedFor(next)) {
            return redirect('/dashboard?reason=access_changed');
          }
          applyAccess(next);
          try {
            window.hopeNotify('Your access level was updated by an administrator.',
              { variant: 'info', title: 'Access updated' });
          } catch (e) {}
        },
        onLost() {
          redirect('/login?reason=session_ended');
        },
      });
    }

    bootstrap().catch((err) => {
      console.error('[HopePMS] guard failure', err);
      redirect('/login?reason=guard_error');
    });
  </script>
</BaseLayout>

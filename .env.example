# ─── Auth0 (SPA / SDK) ──────────────────────────────────────────────────────
PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
PUBLIC_AUTH0_CLIENT_ID=replace-me
PUBLIC_AUTH0_AUDIENCE=https://api.hopepms.example.com
PUBLIC_AUTH0_REDIRECT_URI=http://localhost:4321/auth/callback

# ─── API Gateway base URL (deployed Lambda fronting endpoint) ───────────────
PUBLIC_API_BASE_URL=http://localhost:4321/api

# ─── Session security (client) ──────────────────────────────────────────────
# 32-byte (base64) key used to derive an AES-GCM wrapping key in the browser.
# Generated per-build or per-deploy — NOT a secret on its own; pairs with a
# per-tab ephemeral salt that lives only in memory.
PUBLIC_SESSION_PEPPER=replace-with-random-base64-32-bytes

# Inactivity timeout (minutes) before forced logout
PUBLIC_SESSION_TIMEOUT_MIN=30

# ─── Backend (Lambda) ───────────────────────────────────────────────────────
PG_HOST=hopedb.cluster-xxxxx.us-east-1.rds.amazonaws.com
PG_PORT=5432
PG_DATABASE=hopedb
PG_USER=hopepms_app
PG_PASSWORD=replace-me
PG_SSL=true

# Auth0 token validation (Lambda authorizer)
AUTH0_ISSUER=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.hopepms.example.com
AUTH0_JWKS_URI=https://your-tenant.us.auth0.com/.well-known/jwks.json

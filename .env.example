# ═══════════════════════════════════════════════════════════════════════════
# HopePMS environment configuration
# ═══════════════════════════════════════════════════════════════════════════
#
# Two services run side-by-side:
#   - Astro frontend (this directory)  → AWS Amplify compute (SSR)
#   - Spring Boot backend (/backend)   → Amazon ECS (Fargate)
#
# Frontend env vars are prefixed PUBLIC_ (Astro convention — exposed to the
# browser bundle). Backend env vars have no prefix and are read by Spring Boot
# at startup; set them on the ECS task definition.

# ─── Frontend (Astro / Amplify) ─────────────────────────────────────────────
# Base URL of the Spring Boot API. In local dev, Amplify rewrites or a Vite
# proxy can map /api/* → http://localhost:8080/api/*.
PUBLIC_API_BASE_URL=https://api.hopepms.example.com/api

# ─── Backend: Database (Amazon RDS PostgreSQL) ──────────────────────────────
DB_URL=jdbc:postgresql://hopedb.cluster-xxxxx.us-east-1.rds.amazonaws.com:5432/hopedb
DB_USER=hopepms_app
DB_PASSWORD=replace-me

# ─── Backend: Volatile session store (ElastiCache for Redis) ───────────────
REDIS_HOST=hopepms.xxxxx.cache.amazonaws.com
REDIS_PORT=6379
REDIS_SSL=true

# ─── Backend: Auth0 (Authorization Code + PKCE, server-side) ───────────────
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me-very-secret
AUTH0_AUDIENCE=https://api.hopepms.example.com
AUTH0_REDIRECT_URI=https://api.hopepms.example.com/api/auth/callback
AUTH0_LOGOUT_RETURN_TO=https://hopepms.example.com/login

# ─── Backend: CORS ─────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://hopepms.example.com

# ─── Backend: Session cookie policy ────────────────────────────────────────
# Always true in production. Local dev (no TLS) can flip this to false.
SESSION_COOKIE_SECURE=true
